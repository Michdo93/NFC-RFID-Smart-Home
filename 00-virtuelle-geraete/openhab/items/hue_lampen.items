// ============================================================================
// Philips-Hue-Lampen (virtuell) – orientiert am Hue-Binding (API v2)
//   Thing-Typ: hue:device / hue:room   Channels:
//     switch             -> Switch
//     color              -> Color  (HSB "Hue,Sättigung,Helligkeit")
//     brightness         -> Dimmer
//     color-temperature  -> Dimmer (0 % = kalt ... 100 % = warm)
//     scene              -> String
// Namensschema wie in xbox-360-openhab-controller: <Raum>_Hue_Lampen_<Funktion>
// ============================================================================


Group iKueche_Hue_Lampen "Hue-Lampen Küche" <light> (gKueche) ["Lightbulb"]
Switch iKueche_Hue_Lampen_Schalter "Licht Küche [%s]" <light> (iKueche_Hue_Lampen, gLichter) ["Switch", "Light"]
Color  iKueche_Hue_Lampen_Farbe "Farbe Küche" <colorwheel> (iKueche_Hue_Lampen) ["Control", "Color"]
Dimmer iKueche_Hue_Lampen_Helligkeit "Helligkeit Küche [%d %%]" <light> (iKueche_Hue_Lampen, gDimmbar) ["Control", "Light"]
Dimmer iKueche_Hue_Lampen_Farbtemperatur "Farbtemperatur Küche [%d %%]" <colorlight> (iKueche_Hue_Lampen, gDimmbar) ["Control", "ColorTemperature"]
String iKueche_Hue_Lampen_Szene "Szene Küche [%s]" <light> (iKueche_Hue_Lampen) ["Control"]

Group iBad_Hue_Lampen "Hue-Lampen Bad" <light> (gBad) ["Lightbulb"]
Switch iBad_Hue_Lampen_Schalter "Licht Bad [%s]" <light> (iBad_Hue_Lampen, gLichter) ["Switch", "Light"]
Color  iBad_Hue_Lampen_Farbe "Farbe Bad" <colorwheel> (iBad_Hue_Lampen) ["Control", "Color"]
Dimmer iBad_Hue_Lampen_Helligkeit "Helligkeit Bad [%d %%]" <light> (iBad_Hue_Lampen, gDimmbar) ["Control", "Light"]
Dimmer iBad_Hue_Lampen_Farbtemperatur "Farbtemperatur Bad [%d %%]" <colorlight> (iBad_Hue_Lampen, gDimmbar) ["Control", "ColorTemperature"]
String iBad_Hue_Lampen_Szene "Szene Bad [%s]" <light> (iBad_Hue_Lampen) ["Control"]

